{
  "manifest_version": 3,
  "name": "Robinhood Fair Value Overlay (Claude Build)",
  "version": "1.5.2",
  "description": "Overlays walk-forward variance forecasts, Haugh gamma-weighted edges, and skew-aware option research diagnostics.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://home.treasury.gov/*"],
  "action": {
    "default_title": "Fair Value Overlay (Claude Build)",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://robinhood.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
