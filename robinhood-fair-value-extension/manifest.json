{
  "manifest_version": 3,
  "name": "FairVal SPY Volatility Research",
  "version": "2.3.0",
  "description": "SPY volatility research with adaptive American pricing, GARCH/HAR forecasts, executable structures, and walk-forward paper diagnostics.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://home.treasury.gov/*"],
  "action": {
    "default_title": "FairVal SPY Research",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://robinhood.com/*"],
      "js": ["pricing-core.js", "strategy-core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["volatility-research-output/latest_forecasts.json"],
      "matches": ["https://robinhood.com/*"]
    }
  ]
}
