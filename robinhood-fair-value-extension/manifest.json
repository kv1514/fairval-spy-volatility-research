{
  "manifest_version": 3,
  "name": "Robinhood Fair Value Overlay",
  "version": "1.3.0",
  "description": "Continuously refreshes Robinhood Mark/IV data and records volatility-screen paper outcomes.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://home.treasury.gov/*"],
  "action": {
    "default_title": "Fair Value Overlay",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://robinhood.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
